<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EX MACHINA // Loot Priority Roster</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0C0F;
    --panel:#12161B;
    --panel-2:#161B21;
    --line:#232A32;
    --amber:#FFB627;
    --amber-dim:#8A6A1F;
    --cyan:#4FD1C5;
    --text:#E4E7EB;
    --muted:#6B7480;
    --danger:#E5484D;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background:
      radial-gradient(ellipse 1200px 600px at 50% -10%, rgba(79,209,197,0.06), transparent),
      var(--bg);
    color:var(--text);
    font-family:'IBM Plex Mono', monospace;
    min-height:100vh;
    padding:32px 20px 80px;
  }
  .wrap{max-width:1280px; margin:0 auto;}

  header{
    display:flex; justify-content:space-between; align-items:flex-end;
    flex-wrap:wrap; gap:16px;
    border-bottom:1px solid var(--line);
    padding-bottom:20px; margin-bottom:6px;
  }
  .brand-block{ display:flex; align-items:center; gap:20px; }
  .logo-badge{
    width:96px; height:96px; border-radius:14px; overflow:hidden;
    border:1px solid var(--amber-dim); background:#000;
    box-shadow:0 0 28px rgba(255,182,39,0.28);
    flex:0 0 auto;
  }
  .logo-badge img{ width:100%; height:100%; object-fit:cover; display:block; }
  .guild-name{
    font-family:'Rajd', sans-serif; font-weight:700; font-size:clamp(28px,4vw,44px);
    letter-spacing:0.04em; text-transform:uppercase; line-height:1; color:var(--amber);
    text-shadow:0 0 18px rgba(255,182,39,0.35);
  }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:0.3;} }
  h1{
    font-family:'Rajdhani', sans-serif; font-weight:700; font-size:clamp(28px,4vw,44px);
    letter-spacing:0.02em; text-transform:uppercase; line-height:1;
  }
  h1 span{color:var(--amber);}
  .meta{
    font-size:11px; color:var(--muted); text-align:right; line-height:1.7;
    letter-spacing:0.04em; text-transform:uppercase;
  }
  .meta b{color:var(--text); font-weight:600;}

  .access-strip{
    display:flex; gap:24px; flex-wrap:wrap; align-items:center;
    font-size:11px; color:var(--muted); letter-spacing:0.05em; text-transform:uppercase;
    padding:14px 0 20px; border-bottom:1px solid var(--line); margin-bottom:20px;
  }
  .access-strip .tag{
    display:inline-flex; align-items:center; gap:6px;
    border:1px solid var(--line); padding:4px 10px; border-radius:2px;
    color:var(--muted);
  }
  .access-strip .tag.view{color:var(--cyan); border-color:rgba(79,209,197,0.35);}
  .access-strip .tag.lock{color:var(--amber); border-color:rgba(255,182,39,0.35);}

  .legend{
    display:flex; flex-wrap:wrap; gap:8px 20px;
    font-size:10.5px; color:var(--muted); letter-spacing:0.01em;
    padding:0 0 24px;
  }
  .legend .li{ display:flex; align-items:center; gap:6px; }
  .legend .li b{ color:var(--amber); font-family:'IBM Plex Mono'; }

  .panel{
    background:var(--panel);
    border:1px solid var(--line);
    position:relative;
    overflow:hidden;
  }
  .panel::before, .panel::after{
    content:''; position:absolute; width:14px; height:14px;
    border-color:var(--amber); border-style:solid; opacity:0.6;
  }
  .panel::before{ top:-1px; left:-1px; border-width:2px 0 0 2px; }
  .panel::after{ bottom:-1px; right:-1px; border-width:0 2px 2px 0; }

  .table-scroll{ overflow-x:auto; }
  table{ width:100%; border-collapse:collapse; font-size:13px; min-width:1200px; }
  thead th{
    position:sticky; top:0; background:var(--panel-2);
    text-align:left; font-family:'IBM Plex Mono'; font-weight:600;
    font-size:10px; letter-spacing:0.03em; text-transform:uppercase; color:var(--muted);
    padding:10px 12px; border-bottom:1px solid var(--line);
    cursor:pointer; user-select:none; line-height:1.4; vertical-align:bottom;
  }
  thead th .th-main{ white-space:nowrap; display:flex; align-items:center; }
  thead th .th-lines{ display:flex; flex-direction:column; }
  thead th .th-line{ white-space:normal; font-size:9.5px; color:var(--muted); font-weight:500; text-transform:none; }
  thead th .th-pt{ display:block; font-size:13px; color:var(--amber); font-weight:700; letter-spacing:0.02em; margin-bottom:2px; }
  thead th:hover{ color:var(--cyan); }
  thead th.sorted{ color:var(--amber); }
  thead th.sorted .th-pt{ color:var(--amber); }
  thead th .arrow{ font-size:9px; margin-left:4px; opacity:0.7; }
  tbody td{
    padding:11px 12px; border-bottom:1px solid var(--line); white-space:nowrap;
    color:var(--text);
  }
  tbody tr{ transition:background 0.12s ease; }
  tbody tr:hover{ background:rgba(79,209,197,0.045); }
  tbody tr:nth-child(even){ background:rgba(255,255,255,0.012); }

  .char-name{ font-family:'Rajdhani', sans-serif; font-weight:600; font-size:15px; letter-spacing:0.01em; }
  .biosuit{ color:var(--muted); font-size:11.5px; letter-spacing:0.03em; }
  .num{ text-align:right; font-variant-numeric:tabular-nums; }
  .pct{ color:var(--cyan); }

  .rank-badge{
    display:inline-flex; align-items:center; justify-content:center;
    min-width:26px; height:22px; padding:0 6px;
    border:1px solid var(--amber); color:var(--amber);
    font-size:11.5px; font-weight:700; font-variant-numeric:tabular-nums;
    background:rgba(255,182,39,0.08);
  }
  .rank-badge.top{ background:rgba(255,182,39,0.16); box-shadow:0 0 10px rgba(255,182,39,0.2); }

  .tier-val{
    display:inline-flex; align-items:center; justify-content:center;
    min-width:22px; height:20px; padding:0 5px;
    font-size:11.5px; font-weight:600; font-variant-numeric:tabular-nums;
    color:var(--muted);
  }
  .tier-val.hit{
    color:var(--danger);
    border:1px solid rgba(229,72,77,0.4);
    background:rgba(229,72,77,0.08);
  }

  .penalty{ color:var(--danger); font-weight:600; }
  .penalty.zero{ color:var(--muted); font-weight:400; }

  footer{
    margin-top:22px; padding-top:18px; border-top:1px solid var(--line);
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;
    font-size:10.5px; color:var(--muted); letter-spacing:0.04em; text-transform:uppercase;
  }

  @media (max-width:640px){
    .meta{ text-align:left; }
    header{ flex-direction:column; align-items:flex-start; }
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div class="brand-block">
      <div class="logo-badge"><img src="data:image/png;base64," alt="ExMachina logo"></div>
      <div class="guild-name">ExMachina</div>
    </div>
    <div class="meta">
      <div id="gen-date-header"></div>
      <div>Sorted by priority &mdash; lower number rolls first</div>
    </div>
  </header>

  <div class="access-strip">
    <span class="tag view">&#9679; View-only for guild</span>
    <span class="tag lock">&#128274; Combat Power is only visible to Guild Officers</span>
    <span class="tag">Tier columns show item counts, not penalty points</span>
  </div>

  <div class="panel">
    <div class="table-scroll">
      <table id="loot-table">
        <thead>
          <tr id="table-head"></tr>
        </thead>
        <tbody id="table-body"></tbody>
      </table>
    </div>
  </div>


</div>

<script>
const DATA = {"headers": ["Character Name", "Biosuit", "Weekly", "Cumulative", "Loot Weight %", "T1 Items / R. Passive / Active 3", "T2 Items / Active 4,5", "T3 Items / E. Passive", "T4 Items", "E. Active", "Base Rank", "Loot Penalty", "Priority # (lower=first)", "Loot Priority"], "rows": [["XERXES", "Arbiter", 3030, 16295, 0.04409366471, 0, 0, 1, 0, 0, 1, 3, 4, 1], ["YUNGMAMAMO", "Arbiter", 3030, 15675, 0.03864035768, 0, 0, 0, 0, 0, 5, 0, 5, 2], ["Dephyle", "Arbiter", 3030, 15350, 0.04389442802, 0, 0, 1, 0, 0, 2, 3, 5, 2], ["drKWAKKWAK", null, 3030, 16045, 0.03912254397, 0, 1, 0, 0, 0, 4, 2, 6, 4], ["TIMESHFTR", "Enforcer", 3030, 10670, 0.03469854358, 0, 0, 0, 0, 0, 6, 0, 6, 4], ["cRAULo", "Demolisher", 3030, 14520, 0.03455442165, 0, 0, 0, 0, 0, 7, 0, 7, 6], ["Pepot", "Demolisher", 3030, 16155, 0.04287892269, 0, 1, 1, 0, 0, 3, 5, 8, 7], ["khun", "Arbiter", 3030, 14100, 0.03319342158, 0, 0, 0, 0, 0, 10, 0, 10, 10], ["cmoms", "Punisher", 3030, 14005, 0.03386479241, 0, 0, 0, 0, 0, 8, 0, 8, 7], ["yfgnr", "Punisher", 3030, 14005, 0.03348274071, 0, 0, 0, 0, 0, 9, 0, 9, 9], ["RickMyCrit", "Psypher", 3030, 13640, 0.03302895507, 0, 0, 0, 0, 0, 11, 0, 11, 11], ["Gantze", "Psypher", 3030, 13185, 0.03280710564, 0, 0, 0, 0, 0, 12, 0, 12, 12], ["Shneibel", "Technician", 3030, 4000, 0.03116762406, 0, 0, 0, 0, 0, 14, 0, 14, 14], ["Fuzz", "Demolisher", 3030, 12310, 0.03123912117, 0, 0, 0, 0, 0, 13, 0, 13, 13], ["Lingahsf", "Punisher", 3030, 11865, 0.03078678585, 0, 0, 0, 0, 0, 15, 0, 15, 15], ["Tsjmbz", "Punisher", 3030, 11775, 0.03054572534, 0, 0, 0, 0, 0, 16, 0, 16, 16], ["vnbg", "Punisher", 3030, 11760, 0.03000982422, 0, 0, 0, 0, 0, 17, 0, 17, 17], ["Vassalo", "Technician", 3030, 9440, 0.02780375557, 0, 0, 0, 0, 0, 18, 0, 18, 18], ["renSama", "Psypher", 3030, 4750, 0.02698356293, 0, 0, 0, 0, 0, 19, 0, 19, 19], ["Zkrede", "Punisher", 3030, 8770, 0.02627778523, 0, 0, 0, 0, 0, 22, 0, 22, 22], ["smallbear", "Demolisher", 3030, 8900, 0.02632611405, 0, 0, 0, 0, 0, 21, 0, 21, 21], ["MrJe", "Demolisher", 3030, 8710, 0.02698134847, 0, 0, 0, 0, 0, 20, 0, 20, 20], ["HeavyShot", "Demolisher", 3030, 7240, 0.02449787413, 0, 0, 0, 0, 0, 23, 0, 23, 23], ["Kelarina", "Psypher", 3030, 4750, 0.02164609118, 0, 0, 0, 0, 0, 24, 0, 24, 24], ["yYAMADEUSZYy", "Dreadnaught", 3030, 4810, 0.02115445773, 0, 0, 0, 0, 0, 26, 0, 26, 26], ["Rajadinha", "Technician", 3030, 4310, 0.02037330184, 0, 0, 0, 0, 0, 28, 0, 28, 28], ["moose560", "Arbiter", 3030, 4400, 0.02134119996, 0, 0, 0, 0, 0, 25, 0, 25, 25], ["Delain", "Enforcer", 3030, 4280, 0.02066237165, 0, 0, 0, 0, 0, 27, 0, 27, 27], ["Firefly911", "Psypher", 3030, 3460, 0.01938810978, 0, 0, 0, 0, 0, 29, 0, 29, 29], ["firballfrany", "Enforcer", 3030, 2960, 0.0185203445, 0, 0, 0, 0, 0, 30, 0, 30, 30], ["Sertain", "Punisher", 3030, 2140, 0.01835528162, 0, 0, 0, 0, 0, 31, 0, 31, 31], ["Federslllll", "Punisher", 3030, 2140, 0.01762741172, 0, 0, 0, 0, 0, 32, 0, 32, 32], ["Janelle", "Arbiter", 3030, 880, 0.01674441707, 0, 0, 0, 0, 0, 33, 0, 33, 33], ["JBreezy", "Psypher", 3030, 880, 0.01583857983, 0, 0, 0, 0, 0, 35, 0, 35, 35], ["Drefanos", "Technician", 3030, 880, 0.01584456713, 0, 0, 0, 0, 0, 34, 0, 34, 34], ["RY0MA", "Dreadnaught", 3030, 620, 0.01562444723, 0, 0, 0, 0, 0, 36, 0, 36, 36]]};

const COLS = [
  {key:0,  label:'Names',        lines:null, type:'name'},
  {key:1,  label:'Biosuit',      lines:null, type:'text'},
  {key:2,  label:'Weekly',       lines:null, type:'int'},
  {key:3,  label:'Cumulative',   lines:null, type:'int'},
  {key:4,  label:'Loot Wt %',    lines:null, type:'pct'},
  {key:5,  label:'T1 Epic Items', lines:['R. Passive Skill','Active Skill 3'], pt:1, type:'tier'},
  {key:6,  label:'T2 Epic Items', lines:['Active Skill 4/5'], pt:2, type:'tier'},
  {key:7,  label:'T3 Epic Items', lines:['E.Passive Skill'], pt:3, type:'tier'},
  {key:8,  label:'T4 Epic Items', lines:null, pt:4, type:'tier'},
  {key:9,  label:'Prime Items',   lines:['Epic Active Skills'], pt:5, type:'tier'},
  {key:10, label:'Base Rank',    lines:null, type:'int'},
  {key:11, label:'Penalty',      lines:null, type:'penalty'},
  {key:12, label:'Priority #',   lines:null, type:'rank'},
];

let sortCol = 12, sortAsc = true;
// Priority # column (index 12) is replaced with the Loot Priority values (original index 13),
// and the separate Loot Order column is dropped from the display.
let rows = DATA.rows.map(r => {
  const copy = r.slice(0, 13);
  copy[12] = r[13];
  return copy;
});

function render(){
  const thead = document.getElementById('table-head');
  thead.innerHTML = COLS.map(c => {
    const active = c.key === sortCol;
    const arrow = active ? (sortAsc ? '\u25b2' : '\u25bc') : '';
    const align = ['int','pct','tier','penalty','rank'].includes(c.type) ? 'text-align:right' : '';
    let ptHtml = c.pt ? '<span class="th-pt">+' + c.pt + '</span>' : '';
    let linesHtml = '';
    if(c.lines){
      linesHtml = '<span class="th-lines">' + c.lines.map(l => '<span class="th-line">' + l + '</span>').join('') + '</span>';
    }
    return '<th style="' + align + '" class="' + (active?'sorted':'') + '" data-col="' + c.key + '">' + ptHtml + '<span class="th-main">' + c.label + '<span class="arrow">' + arrow + '</span></span>' + linesHtml + '</th>';
  }).join('');

  const tbody = document.getElementById('table-body');
  tbody.innerHTML = rows.map(r => {
    return '<tr>' + COLS.map(c => {
      const v = r[c.key];
      switch(c.type){
        case 'name':
          return '<td><div class="char-name">' + (v ?? '\u2014') + '</div></td>';
        case 'text':
          return '<td class="biosuit">' + (v ?? '\u2014') + '</td>';
        case 'int':
          return '<td class="num">' + (v==null?'\u2014':Number(v).toLocaleString()) + '</td>';
        case 'pct':
          return '<td class="num pct">' + (v==null?'\u2014':(Number(v)*100).toFixed(2)+'%') + '</td>';
        case 'tier': {
          const n = Number(v) || 0;
          const cls = n > 0 ? 'tier-val hit' : 'tier-val';
          return '<td class="num"><span class="' + cls + '">' + n + '</span></td>';
        }
        case 'penalty':
          return '<td class="num ' + (Number(v)>0?'penalty':'penalty zero') + '">' + (v==null?'\u2014':v) + '</td>';
        case 'rank': {
          const n = Number(v);
          return '<td class="num"><span class="rank-badge ' + (n<=3?'top':'') + '">' + v + '</span></td>';
        }
        default:
          return '<td class="num">' + (v ?? '\u2014') + '</td>';
      }
    }).join('') + '</tr>';
  }).join('');
}

document.getElementById('table-head').addEventListener('click', (e) => {
  const th = e.target.closest('th');
  if(!th) return;
  const col = Number(th.dataset.col);
  if(sortCol === col){ sortAsc = !sortAsc; } else { sortCol = col; sortAsc = true; }
  rows.sort((a,b) => {
    let av = a[col], bv = b[col];
    if(av == null) av = typeof bv === 'string' ? '' : -Infinity;
    if(bv == null) bv = typeof av === 'string' ? '' : -Infinity;
    if(typeof av === 'string') return sortAsc ? av.localeCompare(bv) : bv.localeCompare(av);
    return sortAsc ? av - bv : bv - av;
  });
  render();
});

document.getElementById('gen-date-header').textContent = 'Generated ' + new Date().toISOString().slice(0,10);
render();
</script>
</body>
</html>
